# Anthropic API Key (only needed when using Claude)
ANTHROPIC_API_KEY=your-api-key-here

# LLM Provider: "auto", "claude", "local", "openai", or "openai_compatible"
LLM_PROVIDER=auto

# Claude model (used when provider resolves to Claude)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Local OpenAI-compatible LLM configuration
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_MODEL_PREFERRED=
LOCAL_LLM_API_KEY=not-needed

# Generation defaults
MAX_TOKENS=4096
TEMPERATURE=0.0

# Optional: Clang path (if not in PATH)
# CLANG_PATH=/opt/homebrew/opt/llvm/bin/clang

# MCP server endpoints
MCP_STATIC_SERVER_URL=http://127.0.0.1:8081/mcp
MCP_DYNAMIC_SERVER_URL=http://127.0.0.1:8080/mcp

# Optional: spawn MCP servers as subprocesses instead of HTTP
# MCP_STATIC_SERVER_CMD=python -m src.static_server
# MCP_STATIC_SERVER_CWD=
# MCP_DYNAMIC_SERVER_CMD=python -m src.dynamic_server
# MCP_DYNAMIC_SERVER_CWD=

# Optional: extra MCP client timeouts
# MCP_HTTP_TIMEOUT_SECONDS=30
# MCP_LONG_RUNNING_HTTP_TIMEOUT_SECONDS=1800

# App workspace / persistence
# MEMORY_LEAK_APP_WORKSPACE_ROOTS=/path/to/repos:/another/path
# MEMORY_LEAK_APP_ARTIFACT_DIR=/path/to/artifacts
# MEMORY_LEAK_APP_DB_PATH=/path/to/memory_leak_app.sqlite3
# MEMORY_LEAK_APP_FRONTEND_DIR=/path/to/frontend/dist

# Judge controls
MEMORY_LEAK_JUDGE_MODE=llm
MEMORY_LEAK_JUDGE_SCOPE=selective
MEMORY_LEAK_JUDGE_BATCH_SIZE=8

# Static analysis tuning
MEMORY_LEAK_STATIC_EXPANSION_MODE=balanced
MEMORY_LEAK_FILE_ANALYSIS_CONCURRENCY=4
MEMORY_LEAK_STATIC_TOOL_CONCURRENCY=3

# Dynamic analysis tuning
MEMORY_LEAK_DYNAMIC_MODE=selective
MEMORY_LEAK_DYNAMIC_TOOL_PREFERENCE=auto
MEMORY_LEAK_DYNAMIC_TIMEOUT_SEC=120
# MEMORY_LEAK_DYNAMIC_MAX_ROUNDS=2
